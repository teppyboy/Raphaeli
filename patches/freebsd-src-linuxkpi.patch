diff --git a/sys/compat/linuxkpi/common/include/asm/processor.h b/sys/compat/linuxkpi/common/include/asm/processor.h
index 2bc4b6532..47772ebc6 100644
--- a/sys/compat/linuxkpi/common/include/asm/processor.h
+++ b/sys/compat/linuxkpi/common/include/asm/processor.h
@@ -48,11 +48,31 @@
 struct cpuinfo_x86 {
 	uint8_t		x86;
 	uint8_t		x86_model;
+	uint8_t		x86_stepping;
 	uint16_t	x86_clflush_size;
 	uint16_t	x86_max_cores;
 	uint8_t		x86_vendor;
 };
 
+/* CPU match table, as in Linux's mod_devicetable.h; consumed by
+ * linuxkpi_x86_match_cpu() in linux_compat.c. */
+#define	X86_VENDOR_ANY		0xfffe
+#define	X86_FAMILY_ANY		0xfffe
+#define	X86_MODEL_ANY		0xfffe
+#define	X86_STEPPING_ANY	0
+#define	X86_FEATURE_ANY		0
+#define	X86_CPU_ID_FLAG_ENTRY_VALID	(1 << 0)
+
+struct x86_cpu_id {
+	uint16_t	vendor;
+	uint16_t	family;
+	uint16_t	model;
+	uint16_t	steppings;
+	uint16_t	feature;
+	uint16_t	flags;
+	unsigned long	driver_data;
+};
+
 extern struct cpuinfo_x86	boot_cpu_data;
 extern struct cpuinfo_x86	*__cpu_data;
 #define	cpu_data(cpu)	__cpu_data[cpu]
