<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleIdentifier</key><string>me.tretrauit.raphaeli</string>
  <key>CFBundleName</key><string>Raphaeli</string>
  <key>CFBundleExecutable</key><string>Raphaeli</string>
  <key>CFBundlePackageType</key><string>KEXT</string>
  <key>CFBundleVersion</key><string>1.0.0</string>
  <key>CFBundleShortVersionString</key><string>1.0.0</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>IOKitPersonalities</key><dict>
    <key>Raphaeli780M</key><dict>
      <key>CFBundleIdentifier</key><string>me.tretrauit.raphaeli</string>
      <key>IOClass</key><string>Raphaeli</string>
      <key>IOProviderClass</key><string>IOPCIDevice</string>
      <!-- AMD display-class functions, first target Radeon 780M (Phoenix, 0x15bf, gfx1103); the vendor-wide
           match also covers other AMD display functions. Opt-in: raphaeli-amd=1 or the device property
           "raphaeli-gpu"; probe() declines every device the user did not opt in, so the score only matters for
           devices the user handed to this driver -->
      <key>IOPCIPrimaryMatch</key><string>0x00001002&amp;0x0000ffff</string>
      <key>IOPCIClassMatch</key><string>0x03000000&amp;0xff000000</string>
      <key>IOProbeScore</key><integer>60000</integer>
    </dict>
    <key>RaphaeliIntel</key><dict>
      <key>CFBundleIdentifier</key><string>me.tretrauit.raphaeli</string>
      <key>IOClass</key><string>Raphaeli</string>
      <key>IOProviderClass</key><string>IOPCIDevice</string>
      <!-- Intel display-class functions (opt-in: raphaeli-intel=1 or "raphaeli-gpu"); probe() declines every one
           the user did not opt in, so the score only matters for devices the user handed to this driver -->
      <key>IOPCIPrimaryMatch</key><string>0x00008086&amp;0x0000ffff</string>
      <key>IOPCIClassMatch</key><string>0x03000000&amp;0xff000000</string>
      <key>IOProbeScore</key><integer>60000</integer>
    </dict>
    <!-- RaphaeliFB: IOFramebuffer over the scanout buffer. Unlike the Raphaeli service above it has no probe()-level
         opt-in (its gates are BAR0 + scanout allocation in start()), so the personality is deliberately narrowed to
         the primary target device (780M, 0x15bf) instead of the vendor-wide match: a vendor-wide personality would
         bind (allocate a scanout buffer + publish a framebuffer on) any AMD/Intel display-class GPU on hosts where
         the user never opted in, including this dev host. Widening it needs an opt-in/probe gate in nmx_fb.cpp first.
         Same IOMatchCategory-free default as Raphaeli780M; both can bind the one device (distinct default categories) -->
    <key>RaphaeliFB</key><dict>
      <key>CFBundleIdentifier</key><string>me.tretrauit.raphaeli</string>
      <key>IOClass</key><string>RaphaeliFB</string>
      <key>IOProviderClass</key><string>IOPCIDevice</string>
      <key>IOPCIPrimaryMatch</key><string>0x000015bf&amp;0xffffffff</string>
      <key>IOPCIClassMatch</key><string>0x03000000&amp;0xff000000</string>
      <key>IOProbeScore</key><integer>1000</integer>
    </dict>
    <!-- RaphaeliAccel: IOAcceleratorFamily2 nub. Matches every AMD/Intel display-class function, but start()
         declines unless the provider carries "nmxgpu-claimed" (set by the Raphaeli service after a successful
         attach), so it is inert on hosts where the main service never claimed the GPU. The IOMatchCategory is what
         allows Raphaeli and RaphaeliAccel on the same PCI function. No IOUserClientClass keys: the family's
         IOGraphicsAccelerator2::newUserClient creates every standard client type itself -->
    <key>RaphaeliAccel</key><dict>
      <key>CFBundleIdentifier</key><string>me.tretrauit.raphaeli</string>
      <key>IOClass</key><string>RaphaeliAccel</string>
      <key>IOProviderClass</key><string>IOPCIDevice</string>
      <key>IOPCIPrimaryMatch</key><string>0x00001002&amp;0x0000ffff</string>
      <key>IOPCIClassMatch</key><string>0x03000000&amp;0xff000000</string>
      <key>IOMatchCategory</key><string>IOAccelerator</string>
      <key>IOProbeScore</key><integer>100</integer>
    </dict>
    <key>RaphaeliAccelIntel</key><dict>
      <key>CFBundleIdentifier</key><string>me.tretrauit.raphaeli</string>
      <key>IOClass</key><string>RaphaeliAccel</string>
      <key>IOProviderClass</key><string>IOPCIDevice</string>
      <key>IOPCIPrimaryMatch</key><string>0x00008086&amp;0x0000ffff</string>
      <key>IOPCIClassMatch</key><string>0x03000000&amp;0xff000000</string>
      <key>IOMatchCategory</key><string>IOAccelerator</string>
      <key>IOProbeScore</key><integer>100</integer>
    </dict>
  </dict>
  <key>OSBundleLibraries</key><dict>
    <key>com.apple.kpi.bsd</key><string>8.0</string>
    <key>com.apple.kpi.iokit</key><string>8.0</string>
    <key>com.apple.kpi.libkern</key><string>8.0</string>
    <key>com.apple.kpi.mach</key><string>8.0</string>
    <key>com.apple.kpi.unsupported</key><string>8.0</string>
    <!-- request versions must be <= each family's OSBundleCompatibleVersion (KDK 15.7.8:
         IOPCIFamily/IOGraphicsFamily 1.0.0b1, IOACPIFamily 1.0.0d1, IOAcceleratorFamily2 2.0.0);
         requesting 1.0.0 where only 1.0.0b1 exists fails OC prelinked injection (Invalid Parameter) -->
    <key>com.apple.iokit.IOPCIFamily</key><string>1.0.0b1</string>
    <key>com.apple.iokit.IOACPIFamily</key><string>1.0.0d1</string>
    <key>com.apple.iokit.IOGraphicsFamily</key><string>1.0.0b1</string>
    <key>com.apple.iokit.IOAcceleratorFamily2</key><string>2.0.0</string>
  </dict>
</dict></plist>
